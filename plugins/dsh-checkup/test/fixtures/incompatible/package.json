{
  "name": "dsh-fixture-incompatible",
  "version": "0.0.1",
  "description": "自检用：故意声明当前 DSH 不存在的客户端注入包，并声明不兼容的 dsh 版本范围",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-does-not-exist", "@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "engines": { "dsh": ">=0.9.0" },
  "peerDependencies": { "@deepseek-ai/cordis": "^9.0.0" }
}
