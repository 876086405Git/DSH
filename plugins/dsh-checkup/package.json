{
  "name": "dsh-checkup",
  "version": "0.1.0",
  "description": "DSH体检中心：安装前兼容性/安全性/稳定性预检与环境体检（插件 / skill / MCP）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "plugin",
    "guard",
    "compatibility"
  ],
  "license": "MIT"
}
