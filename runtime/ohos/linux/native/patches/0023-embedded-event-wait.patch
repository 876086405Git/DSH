+#ifdef TEMU_EMBED
+static int slirp_deadline_remaining_us(uint64_t now_us, uint64_t started_ms,
+                                        uint32_t duration_ms, int cap_us)
+{
+    uint64_t elapsed_ms = now_us / 1000 - started_ms;
+    uint64_t remaining_us;
+    if (elapsed_ms >= duration_ms) return 0;
+    remaining_us = ((uint64_t)duration_ms - elapsed_ms) * 1000 - now_us % 1000;
+    return remaining_us < (uint64_t)cap_us ? (int)remaining_us : cap_us;
+}
+
+int slirp_get_sleep_duration_us(Slirp *slirp, int cap_us,
+                                 const struct timespec *host_now)
+{
+    struct socket *so;
+    uint64_t now_us = (uint64_t)host_now->tv_sec * 1000000 + host_now->tv_nsec / 1000;
+    int delay = cap_us;
+    if (delay <= 0) return 0;
+    if (fasttimo_pending)
+        delay = slirp_deadline_remaining_us(now_us, time_fasttimo, 2, delay);
+    /* Existing slow activation covers every TCP timer and IP fragment TTL,
+       including the historical UDP-only activation. Never catch up ticks. */
+    if (do_slowtimo)
+        delay = slirp_deadline_remaining_us(now_us, last_slowtimo, 499, delay);
+    for (so = slirp->udb.so_next; so != &slirp->udb; so = so->so_next)
+        if (so_has_expiry(so))
+            delay = slirp_deadline_remaining_us(now_us, so->so_expire_started_ms,
+                                                 so->so_expire_duration_ms, delay);
+    /* Pending guest output may become writable without new host readiness. */
+    if (slirp->if_queued && slirp_can_output(slirp->opaque)) return 0;
+    return delay;
+}
+#endif
