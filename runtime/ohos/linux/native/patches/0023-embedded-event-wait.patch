+
+int riscv_machine_get_sleep_duration_us_at(VirtMachine *s1, int delay_us,
+                                           const struct timespec *host_now)
+{
+    RISCVMachine *m = (RISCVMachine *)s1;
+    RISCVCPUState *s = m->cpu_state;
+    uint64_t now, remaining;
+
+    /* Preserve unsigned mtime, floor, masked-MTIP and non-WFI semantics.
+       The legacy public wrapper above keeps its original sampling behavior. */
+    if (!(riscv_cpu_get_mip(s) & MIP_MTIP)) {
+        if (m->rtc_real_time) {
+            now = (uint64_t)host_now->tv_sec * RTC_FREQ +
+                host_now->tv_nsec / (1000000000 / RTC_FREQ) - m->rtc_start_time;
+        } else {
+            now = riscv_cpu_get_cycles(s) / RTC_FREQ_DIV;
+        }
+        if (m->timecmp <= now) {
+            riscv_cpu_set_mip(s, MIP_MTIP);
+            delay_us = 0;
+        } else {
+            remaining = (m->timecmp - now) / (RTC_FREQ / 1000000);
+            if (delay_us > 0 && remaining < (uint64_t)delay_us)
+                delay_us = remaining;
+        }
+    }
+    if (!riscv_cpu_get_power_down(s))
+        delay_us = 0;
+    return delay_us;
+}
 #endif
 
