@@ -44,0 +45,4 @@
+#ifdef TEMU_EMBED
+  uint64_t so_expire_started_ms;
+  uint32_t so_expire_duration_ms; /* Zero disables UDP expiry, not a timestamp. */
+#endif
@@ -55,0 +60,43 @@
+
+/* Fixed UDP lifetimes are positive and below the 32-bit half range. */
+#if SO_EXPIRE <= 0 || SO_EXPIRE >= 0x80000000U || SO_EXPIREFAST <= 0 || SO_EXPIREFAST >= 0x80000000U
+#error Invalid UDP expiry duration
+#endif
+#ifdef TEMU_EMBED
+/* Same monotonic sample whose low word remains the legacy curtime. */
+extern uint64_t udp_curtime_ms;
+#endif
+static inline int so_has_expiry(const struct socket *so)
+{
+#ifdef TEMU_EMBED
+    return so->so_expire_duration_ms != 0;
+#else
+    return so->so_expire != 0;
+#endif
+}
+static inline void so_set_expiry(struct socket *so, uint32_t now, uint32_t duration)
+{
+    so->so_expire = now + duration; /* Preserve the legacy diagnostic field. */
+#ifdef TEMU_EMBED
+    so->so_expire_started_ms = udp_curtime_ms;
+    so->so_expire_duration_ms = duration;
+#endif
+}
+static inline void so_clear_expiry(struct socket *so)
+{
+    so->so_expire = 0;
+#ifdef TEMU_EMBED
+    so->so_expire_started_ms = 0;
+    so->so_expire_duration_ms = 0;
+#endif
+}
+static inline int so_expiry_due(const struct socket *so, uint32_t now)
+{
+#ifdef TEMU_EMBED
+    (void)now;
+    /* No 32-bit signed-half-range assumption about a stopped host thread. */
+    return so_has_expiry(so) && udp_curtime_ms - so->so_expire_started_ms >= so->so_expire_duration_ms;
+#else
+    return so_has_expiry(so) && so->so_expire <= now;
+#endif
+}
